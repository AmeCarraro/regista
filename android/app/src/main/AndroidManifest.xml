<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- to talk to the computer it was paired with, and to nothing else -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to read the pictures: asked to the user when the app is first paired. Its name changed with Android 13 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- before Android 10, to keep the pictures that arrive from the computer: they are written as files of their own -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- to read where a picture was taken: without it Android hands pictures over with the place taken out -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- to go on copying the new pictures to the computer after the phone is switched off and on, when the user asked for it -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- to ask for the fingerprint, or the phone's own lock, before the computer's tab opens -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- no backup: the key that lets this phone into the computer must not leave the phone -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:theme="@style/App">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the link in the code the computer shows: the phone's camera reads it and opens the app with it -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="pair" android:scheme="regista" />
            </intent-filter>
        </activity>

        <!-- the copying of the new pictures by themselves, run by Android now and then on a Wi-Fi (CopyJob) -->
        <service
            android:name=".CopyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
