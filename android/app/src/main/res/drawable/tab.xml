<?xml version="1.0" encoding="utf-8"?>
<!-- a tab: the one showing has the app's colours above its name -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item
                android:height="3dp"
                android:gravity="top"
                android:left="40dp"
                android:right="40dp">
                <shape>
                    <gradient android:angle="0" android:centerColor="#E052A0" android:endColor="#7A5CFF" android:startColor="#FF8A5B" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
