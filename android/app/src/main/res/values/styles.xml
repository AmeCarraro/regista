<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ground">#0B0910</color>
    <color name="card">#17131F</color>
    <color name="text">#F6F2F8</color>
    <color name="muted">#AAA1B8</color>
    <color name="rose">#E052A0</color>
    <color name="bad">#FF6B81</color>

    <style name="App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:colorAccent">@color/rose</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>
    <style name="PillButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/go</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PillButton.Secondary">
        <item name="android:background">@drawable/pill</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
