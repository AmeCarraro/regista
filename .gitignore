__pycache__/
.venv/
# what tools\desktop.ps1 and tools\package.ps1 build: Regista.exe and the folder another PC installs from
build/
.pytest_cache/

# the pictures the app looks at are personal: never in the repository
foto/

# what install.ps1 makes for this PC: the file that starts the app on the folder chosen here
Regista.cmd

web/node_modules/
web/dist/
web/dist-telefono/

# the Android app: what a build leaves behind, and the key builds are signed with
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/.keys/
# Google's adb for Windows, to reach a real phone through its cable (android.ps1 tablet)
android/.tools/
# copied in by android.ps1 at every build: the phone's screen, built from web/, and the table of places
android/app/src/main/assets/telefono/
android/app/src/main/assets/places/
android/app/src/main/assets/commands/
android/local.properties

# the models the phone app runs by itself: downloaded once from Hugging Face, too large for the repository
models/
